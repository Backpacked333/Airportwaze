# =================================
# AirportWaze Frontend Configuration
# =================================

# API Configuration
# ----------------------------------
# URL of the backend API
# Development: http://localhost:8000
# Production: https://app-awudjxxy.fly.dev
VITE_API_URL=http://localhost:8000

# Feature Flags
# ----------------------------------
# Enable analytics tracking
VITE_ENABLE_ANALYTICS=false

# Enable error tracking with Sentry
VITE_ENABLE_ERROR_TRACKING=false

# Error Tracking (Sentry)
# ----------------------------------
# Sentry DSN for error reporting
# Get this from https://sentry.io/settings/projects/
VITE_SENTRY_DSN=

# Sentry environment (development, staging, production)
VITE_SENTRY_ENVIRONMENT=development

# Sentry traces sample rate (0.0 to 1.0)
# 1.0 = 100% of transactions are sent to Sentry
VITE_SENTRY_TRACES_SAMPLE_RATE=0.1

# Analytics
# ----------------------------------
# Google Analytics Measurement ID
VITE_ANALYTICS_ID=

# Mixpanel Project Token
VITE_MIXPANEL_TOKEN=

# Application Configuration
# ----------------------------------
# Application name displayed in the UI
VITE_APP_NAME=AirportWaze

# Application version
VITE_APP_VERSION=1.0.0

# Map Configuration
# ----------------------------------
# Default map center latitude (San Francisco)
VITE_MAP_DEFAULT_CENTER_LAT=37.7749

# Default map center longitude (San Francisco)
VITE_MAP_DEFAULT_CENTER_LNG=-122.4194

# Default map zoom level
VITE_MAP_DEFAULT_ZOOM=13

# Mapbox Access Token (if using Mapbox instead of Leaflet)
VITE_MAPBOX_TOKEN=

# Third-Party Services
# ----------------------------------
# Stripe Publishable Key (for payments)
VITE_STRIPE_PUBLISHABLE_KEY=

# Auth0 Domain (for authentication)
VITE_AUTH0_DOMAIN=

# Auth0 Client ID
VITE_AUTH0_CLIENT_ID=

# Performance & Optimization
# ----------------------------------
# Enable React DevTools in production (not recommended)
VITE_ENABLE_REACT_DEVTOOLS=false

# Enable performance monitoring
VITE_ENABLE_PERFORMANCE_MONITORING=false

# Enable service worker for offline support
VITE_ENABLE_SERVICE_WORKER=false

# Development Configuration
# ----------------------------------
# Enable debug mode (shows additional logging)
VITE_DEBUG_MODE=false

# Mock API responses (useful for development without backend)
VITE_MOCK_API=false

# Show debug panel in UI
VITE_SHOW_DEBUG_PANEL=false

# =================================
# Notes:
# =================================
# - Copy this file to .env.local for local development
# - Never commit .env.local to version control
# - All VITE_ prefixed variables are exposed to the client
# - Sensitive values should be kept in .env.local
# - For production, set these in your hosting platform's environment variables
