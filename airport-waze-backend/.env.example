# AirportWaze Backend Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME="AirportWaze API"
APP_VERSION="2.0.0"
DEBUG=False
ENV=production  # development, staging, production

# API
API_V1_PREFIX=/api

# Database
DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/airportwaze
DB_ECHO=False
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# Redis Cache
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=300
PREDICTION_CACHE_TTL=600

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
CORS_ALLOW_CREDENTIALS=True

# Rate Limiting
RATE_LIMIT_ENABLED=True
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Monte Carlo Simulation
SIMULATION_RUNS=10000
SIMULATION_RUNS_FAST=5000

# Logging
LOG_LEVEL=INFO
LOG_JSON=True

# Sentry Error Tracking (optional)
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1

# External APIs
TSA_API_URL=https://www.tsa.gov/data/apcp.xml
TSA_API_TIMEOUT=10

# Crowdsourced Reports
MAX_REPORTS_IN_MEMORY=10000
REPORTS_CLEANUP_DAYS=7
