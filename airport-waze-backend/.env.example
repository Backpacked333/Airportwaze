# AirportWaze Backend Environment Configuration
# Copy this file to .env and fill in your values

# ============== DATABASE ==============
# For local development (SQLite)
DATABASE_URL=sqlite:///./airportwaze.db

# For production (PostgreSQL)
# DATABASE_URL=postgresql://username:password@localhost:5432/airportwaze

# For production (PostgreSQL with TimescaleDB on Fly.io)
# DATABASE_URL=postgresql://username:password@your-db-host.fly.io:5432/airportwaze

# ============== DATA SOURCE APIS ==============

# Flight Data API Provider
# Options: "none", "aviation_edge", "aerodatabox", "flightaware"
FLIGHT_API_PROVIDER=none

# Flight Data API Key (required if FLIGHT_API_PROVIDER is not "none")
# Get your key from:
# - Aviation Edge: https://aviation-edge.com/premium-api/
# - AeroDataBox: https://rapidapi.com/aedbx-aedbx/api/aerodatabox
# - FlightAware: https://flightaware.com/commercial/firehose/
FLIGHT_API_KEY=

# ============== CACHING (Optional) ==============

# Redis URL for caching (optional)
# REDIS_URL=redis://localhost:6379/0

# ============== APPLICATION ==============

# Environment: development, production
ENVIRONMENT=development

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ============== CORS (Frontend URLs) ==============

# Comma-separated list of allowed origins
# For local development:
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# For production, add your deployed frontend URL:
# ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:5173

# ============== SECURITY ==============

# Secret key for JWT tokens (if implementing authentication)
# Generate with: openssl rand -hex 32
# SECRET_KEY=your-secret-key-here

# ============== MONITORING (Optional) ==============

# Sentry DSN for error tracking
# SENTRY_DSN=

# ============== NOTES ==============

# TSA and CBP APIs are public and don't require keys
# They are automatically used if available

# For TimescaleDB features, ensure you have TimescaleDB extension installed:
# CREATE EXTENSION IF NOT EXISTS timescaledb CASCADE;

# For development, SQLite is recommended (no server needed)
# For production, PostgreSQL + TimescaleDB is recommended
